# --- App Next.js (dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Scraper (scripts/scrape.ts) ---
# Nunca commitear estos valores. En GitHub Actions van como Secrets del repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMPRAR_USER=
COMPRAR_PASS=

# Días de anticipación para avisar de un vencimiento próximo (default: 3)
AVISO_VENCIMIENTO_DIAS=3
