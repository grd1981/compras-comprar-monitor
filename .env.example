# --- App Next.js (dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Scraper (scripts/scrape.ts) ---
# Nunca commitear estos valores. En GitHub Actions van como Secrets del repo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# CUIL/CUIT/Pasaporte: lo que se tipea en la pantalla de Argentina.gob.ar
COMPRAR_USER=
# Usuario GDE (ej: "dgrene") — distinto del CUIL de arriba, se tipea en
# la pantalla propia de GDE junto con la contraseña
COMPRAR_GDE_USER=
COMPRAR_PASS=

# Días de anticipación para avisar de un vencimiento próximo (default: 3)
AVISO_VENCIMIENTO_DIAS=3
